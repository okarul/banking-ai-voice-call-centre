<?xml version="1.0" encoding="utf-8"?>
<!--
  Channel 2 inbound dialplan.

  Drop this into `dialplan/public/` (as `00_channel2.xml`, so it is evaluated
  before the stock extensions). Files in that directory are pulled in by
  `public.xml` from *inside* `<context name="public">`, so this file contains
  bare <extension> elements and must NOT wrap them in a <context> of its own —
  a nested context is silently ignored, and the symptom is a call that reaches
  FreeSWITCH, matches nothing, and comes back 480.

  What it does: pin the codec and bridge the call to the gateway over SIP.
  There is no banking logic here and there must never be any — FreeSWITCH
  terminates the telephone network, and everything about who is calling and
  what they may see is decided by the banking application behind the
  authenticated gateway.

  WHY A SIP BRIDGE, AND NOT AN AUDIO FORK

  An earlier version forked audio with `unicast`. That application **does not
  exist** in FreeSWITCH 1.10.12 — verified against a running build, whose
  mod_dptools offers 178 applications and none of them is `unicast`. The `rtp`
  endpoint does not take a plain address as a dial string either, and the
  modules that do stream audio out (mod_audio_stream, mod_audio_fork) are
  third-party and absent from community images.

  Bridging over SIP needs only mod_sofia, which every build has. It is also the
  better design: SDP negotiates a media port per call, the way RTP has always
  allocated them, so there is no fixed port to collide on and no event-socket
  shim needed to hand ports out. Concurrent calls work by construction.
-->
<include>

  <extension name="channel2_banking_inbound">
    <!-- The demonstration DID, and the 90xx loopback test range. 90xx rather
         than 100x because stock FreeSWITCH claims 1000-1019 for its demo users
         and answers them with voicemail. -->
    <condition field="destination_number" expression="^(6531252836|90[0-9][0-9])$">

      <!-- One codec, both directions, no transcoding inside FreeSWITCH. The
           bank converts µ-law once, for the model, and back. -->
      <action application="set" data="absolute_codec_string=PCMU"/>

      <!-- Do not answer before bridging. Answering first would connect the
           caller to FreeSWITCH and leave them in silence while the gateway leg
           is set up; bridging passes the far side's answer straight through,
           so the caller hears the bank the moment it is ready. -->
      <action application="set" data="hangup_after_bridge=true"/>
      <action application="set" data="continue_on_fail=false"/>

      <!-- The gateway leg. `channel2_gateway_uri` is where the gateway answers
           SIP; a private address on a private link, never a public one. -->
      <action application="bridge"
              data="sofia/channel2/sip:gateway@$${channel2_gateway_uri}"/>

    </condition>
  </extension>

  <!-- Everything else that reaches this file is not a call this bank answers.
       An open dialplan on a reachable SIP port is a free long-distance
       service. -->
  <extension name="channel2_reject_everything_else">
    <condition field="destination_number" expression="^.*$">
      <action application="respond" data="404 Not Found"/>
    </condition>
  </extension>

</include>
