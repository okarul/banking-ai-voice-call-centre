APP_NAME=ABC Demo Bank Voice Banking API
APP_ENV=development

# Copy this file to .env and set your own local password.
# The banking demo database runs on port 5435 to stay isolated from other
# local PostgreSQL instances.
# Use 127.0.0.1 rather than localhost: localhost resolves to IPv6 ::1 first,
# and the database is published on IPv4 only, which makes every connection
# stall for several seconds before falling back.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5435/banking_ai_demo

# Phase 9 - OpenAI Realtime voice.
# Backend only. This key is never sent to the browser, returned by any route,
# or written to a log. Leave it empty here; put the real value in .env, which
# is git-ignored. The application starts and serves /health without it; only
# realtime voice calls are unavailable.
OPENAI_API_KEY=

# Optional overrides. The defaults are the current recommended realtime model
# and voice, so these normally stay unset.
# REALTIME_MODEL=gpt-realtime-2.1
# REALTIME_VOICE=ash

# Phase 13 - voice capacity admission control.
# The largest number of live voice calls this server will open at once. 0 (the
# default) means no limit and is what you want once the OpenAI organisation's
# Realtime capacity comfortably exceeds your class size.
#
# Set it only to a capacity you have actually measured, using
#   python -m loadtest.capacity_smoke --concurrency N
# A caller turned away with "Voice banking is temporarily busy" is a better
# outcome than a call that opens and then stalls silently, but only when the
# ceiling is real. See docs/REALTIME_CAPACITY.md.
# REALTIME_MAX_ACTIVE_SESSIONS=0

# Agent operations dashboard (operator-only, http://127.0.0.1:5173/admin/agents.html)
# Observability only: none of this affects a banking answer, and every value
# below is optional. Anything unset shows on the dashboard as N/A rather than
# as a guess.
# DASHBOARD_ENABLED=true
# DASHBOARD_TIMEZONE=Asia/Singapore

# Model pricing, in USD per one million tokens. Unset by default because
# provider prices change and a stale figure printed to four decimal places
# looks far more authoritative than it is. With these unset, Estimated Cost
# reads N/A. Take the current numbers from the OpenAI pricing page.
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=

# Carbon is an ESTIMATE from the coefficient below, never a provider
# measurement — OpenAI does not publish per-session emissions. Off by default;
# with it off, Est. CO2e reads N/A. If you switch it on, set a coefficient you
# can defend and be clear with your class that it is an assumption.
# CARBON_ESTIMATION_ENABLED=false
# CARBON_GRAMS_PER_KTOK=

# ---------------------------------------------------------------------------
# Phase 1 - telephony foundation (SIP / DIDWW)
# ---------------------------------------------------------------------------
# OFF by default, and it must stay off until the channel is actually built.
# While false: no SIP code initialises, no provider is contacted, no telephony
# route is registered, and the browser voice channel behaves exactly as before.
TELEPHONY_ENABLED=false
TELEPHONY_PROVIDER=DIDWW

# Public identifiers only. A DID number is published to callers by definition
# and a SIP URI is a destination, so neither is a secret.
DIDWW_DID_NUMBER=6531252836
SIP_PUBLIC_URI=
SIP_PROVIDER_DOMAIN=

# NEVER put SIP or DIDWW credentials in this file, or in .env committed
# anywhere. No password, no API token, no auth header. They are deliberately
# absent from `settings` too - see docs/TELEPHONY_SECURITY_PRIVACY_DESIGN.md.

# ---------------------------------------------------------------------------
# Phase 2 - inbound provider event boundary
# ---------------------------------------------------------------------------
# The shared secret inbound events are signed with (HMAC-SHA256 over
# "<timestamp>.<raw body>").
#
# Leave this EMPTY here and put the real value in .env, which is git-ignored.
# With it unset the webhook route is not registered at all: an endpoint that
# cannot verify anything has no safe behaviour available to it, so it does not
# exist. Generate one with:
#
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Backend only. Never returned by a route, never logged, never in
# public_settings().
TELEPHONY_WEBHOOK_SECRET=

# How far a signed timestamp may be from now, in seconds, either direction.
# Five minutes is the usual provider convention: long enough to survive clock
# drift and a retry, short enough that a captured request stops being useful.
# TELEPHONY_SIGNATURE_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# Phase 3 - telephony media
# ---------------------------------------------------------------------------
# How a call's audio reaches this application.
#
#   websocket  a media gateway streams the call here (the real transport)
#   loopback   in-memory, for tests and local development only
#
# There is deliberately no "sip" value. Terminating SIP and RTP needs either a
# SIP stack in this process or a media gateway in front of it; see
# docs/TELEPHONY_MEDIA.md for what has to be decided before a real DIDWW call
# can be answered.
# TELEPHONY_MEDIA_TRANSPORT=websocket

# Timeouts, in seconds. Generous on purpose: a timeout tighter than reality
# turns normal calls into failures.
# TELEPHONY_MEDIA_CONNECT_TIMEOUT=15
# TELEPHONY_REALTIME_CONNECT_TIMEOUT=30
# TELEPHONY_IDLE_CALL_TIMEOUT=900

# Audio queue ceiling per direction per call, in 20 ms frames. 200 frames is
# four seconds. When full the OLDEST frame is dropped, which keeps the
# conversation live rather than letting the delay grow. One caller must never
# be able to make this process hold unbounded memory.
# TELEPHONY_AUDIO_QUEUE_FRAMES=200

# ---------------------------------------------------------------------------
# Phase 4C - the gateway SIP leg (backend/gateway, a SEPARATE service)
# ---------------------------------------------------------------------------
# These belong to the gateway process, not to the bank. In a real deployment it
# runs on its own host with its own environment; they are listed here so the
# whole set is documented in one place.
#
# Where the gateway answers SIP, for a media server to bridge calls to.
# GATEWAY_SIP_HOST=127.0.0.1
# GATEWAY_SIP_PORT=5080
#
# What the gateway puts in its SDP - where the far side should send RTP.
# Separate from the bind address on purpose: behind NAT the address a peer must
# send to is not the address the process bound, and conflating the two is the
# classic one-way-audio failure. Leave empty to advertise the bind address.
# GATEWAY_SIP_ADVERTISE_HOST=
#
# Who may offer this gateway a call, comma separated. REQUIRED before binding
# to anything but loopback: the gateway refuses to start on a reachable
# interface with this empty, because a SIP port with no source restriction is
# found by scanners within hours and every call they place is one the gateway
# would offer to a bank. Set it to the carrier's published signalling addresses.
# GATEWAY_SIP_ALLOWED_PEERS=

# ---------------------------------------------------------------------------
# Application concurrent-call target
# ---------------------------------------------------------------------------
# ONE ceiling for the whole bank, counted across the browser and telephone
# channels together - there is deliberately no separate phone limit.
#
# The Phase 3 application target is 5. Set this to 5 to reach it:
#
#     REALTIME_MAX_ACTIVE_SESSIONS=5
#
# This is the APPLICATION limit and is a separate thing from the external
# provider's practical limit, which was measured at roughly 3 concurrent
# sessions. Do not lower this to match the provider: the application is built
# for 5, and the provider constraint belongs in the provider's own capacity
# planning. See docs/REALTIME_CAPACITY.md.

# ---------------------------------------------------------------------------
# Persistent PIN lockout
# ---------------------------------------------------------------------------
# The per-call limit (three wrong PINs) ends one call. These end the redial
# loop: failures are counted against the claimed customer id across calls, so
# hanging up and calling back does not buy a fresh budget.
#
# Higher than the per-call limit on purpose - three failures in one call is a
# customer who has forgotten their PIN.
# PIN_LOCKOUT_MAX_ATTEMPTS=5

# Both how long a lock lasts and how far back failures are counted. Do not set
# this to 0 expecting a permanent lock: on shared demonstration customers an
# unbounded lock means one mistyped PIN denies DEMO001 to the whole class.
# Production would want a longer window plus a real unlock path.
# PIN_LOCKOUT_MINUTES=15

# Synthetic data only. This is a demonstration bank with no real connector.
DEMO_MODE=true

# Tell callers they are speaking to an AI. Configuration exists from Phase 1;
# the greeting itself is unchanged until the telephone channel is built.
AI_DISCLOSURE_ENABLED=true
# AI_DISCLOSURE_TEXT=This is an AI-powered demonstration using synthetic banking data.

# Retention intent. Phase 1 implements no deletion job; production retention
# must follow organisational and legal policy, not these defaults.
AUDIT_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=7

# Phase 10 - the browser telephone page.
# Origins allowed to call /api/call/*. Comma separated, named explicitly: a
# wildcard would let any page on this machine start banking calls. The default
# matches the bundled frontend on port 5173.
# FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Phase 6.12 - the per-turn conversation trace, for diagnosing a live UAT call.
#
# The trace records what the backend *decided*, turn by turn: which scope
# ruling, which held enquiry, which tool, which reason, how long, and how the
# call ended. None of that is speech.
#
# Off by default for cost, not privacy: every traced event is a database write
# of roughly 35 ms, and a call makes one per turn, per tool and per
# authentication change. That is enough to delay assistant audio when several
# calls are in flight, and a diagnostic must not tax the calls it exists to
# diagnose. Turn it on for the UAT that needs it.
# TRACE_ENABLED=true

# Whether the trace also keeps what was *said*. Off by default, and that
# default is the privacy posture Channel 2 has always had: the telephone has
# never stored a spoken word (checklist Q-121). Turn it on for a UAT and
# utterances are stored only in redacted form - a PIN turn is "[PIN REDACTED]",
# an id turn is "[Customer ID provided]", never the digits.
#
# Turning this on is a deliberate act. Leave it off in production.
# TELEPHONY_TRACE_UTTERANCES=false

# How long a trace is kept. Purged on the sweep that reclaims idle calls.
# There is no unlimited setting: a trace explains a call that has just
# happened, and beyond that it is a second transcript archive nobody asked for.
TRACE_RETENTION_DAYS=14
